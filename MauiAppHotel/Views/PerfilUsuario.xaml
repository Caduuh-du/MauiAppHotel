<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.PerfilUsuario"
             Title="Meu Perfil"
             BackgroundColor="#F5F6FA">

    <ScrollView>
        <VerticalStackLayout VerticalOptions="CenterAndExpand"
                     Padding="10"
                     Spacing="10">

            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
                <Label Text="João Silva" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#2B0B98"/>
                <Label Text="Cliente VIP - Nível Ouro" FontSize="14" TextColor="DarkGoldenrod" FontAttributes="Bold" HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <Frame CornerRadius="12" Padding="15" BackgroundColor="White" HasShadow="True">
                <VerticalStackLayout Spacing="15">

                    <Label Text="Informações da Conta" FontSize="16" FontAttributes="Bold" TextColor="#2B0B98"/>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="E-mail" FontSize="12" TextColor="Gray"/>
                        <Label Text="joao.silva@etec.sp.gov.br" FontSize="15" FontAttributes="Bold"/>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#EFEFEF"/>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Telefone" FontSize="12" TextColor="Gray"/>
                        <Label Text="(11) 98765-4321" FontSize="15"/>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#EFEFEF"/>

                    <VerticalStackLayout Spacing="2">
                        <Label Text="Membro desde" FontSize="12" TextColor="Gray"/>
                        <Label Text="Março de 2026" FontSize="15"/>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </Frame>

            <Button Text="Editar Dados" 
                    Clicked="Button_Clicked"
                    BackgroundColor="#1f2638" 
                    TextColor="#d4af37" 
                    BorderColor="#d4af37"
                    BorderWidth="1"
                    FontAttributes="Bold" 
                    FontSize="14"
                    Margin="0,20,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>